{
  "name": "dsh-inkvault",
  "version": "0.5.0",
  "description": "Obsidian knowledge-base bridge for DeepSeek Harness: path-isolated notes with wikilinks, tags, folders and backlinks.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-shell"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M1r0er/dsh-inkvault.git"
  },
  "homepage": "https://github.com/M1r0er/dsh-inkvault#readme",
  "bugs": {
    "url": "https://github.com/M1r0er/dsh-inkvault/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "obsidian",
    "knowledge-base",
    "markdown",
    "plugin"
  ]
}
